<circuit>
  <version>1</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>4 x 4-bit register file. WE writes Din at WL on the rising edge of c. clr asynchronously clears every register. RE drives Dout from RL, otherwise Dout is high-Z.</string>
    </entry>
