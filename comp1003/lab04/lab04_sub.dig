<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>COMP1003 Lab 04 Exercise 4: 4-bit ALU.\na,b: 4-bit operands. op: 1 bit. fun: 3 bits. cin: status in.\nout: 4-bit result. cout: status out, carry of addition only.\nop fun | operation\n0 000 | a+b+cin\n0 001 | low 4 bits of a*b\n0 010 | a-b-cin\n1 000 | signed compare: bit0 a&gt;b, bit1 a=b, bit2 a&lt;b\n1 001 | logical shift right of a by b\n1 010 | logical shift left of a by b\n1 011 | unsigned compare, same bit encoding</string>
    </entry>
  </attributes>
