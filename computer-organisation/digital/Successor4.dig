            <dataString># All 16 inputs. Full successor includes C_out so 15+1 = 10000.
A_3 A_2 A_1 A_0 C_out S_3 S_2 S_1 S_0
loop(n,16)
bits(4,n) bits(5,n+1)
end loop
</dataString>
