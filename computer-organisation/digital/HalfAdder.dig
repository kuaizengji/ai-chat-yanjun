<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes>
    <entry>
      <string>Description</string>
      <string>Half adder used by the 4-bit successor.
半加器：S = A XOR B，C = A AND B。</string>
    </entry>
    <entry>
      <string>shapeType</string>
      <shapeType>CUSTOM</shapeType>
    </entry>
    <entry>
      <string>Width</string>
      <int>4</int>
    </entry>
    <entry>
      <string>customShape</string>
        <shape>
        <pins>
          <entry>
            <string>A</string>
            <pin>
              <pos x="0" y="0"/>
              <showLabel>true</showLabel>
            </pin>
          </entry>
          <entry>
            <string>B</string>
            <pin>
              <pos x="0" y="40"/>
              <showLabel>true</showLabel>
            </pin>
          </entry>
          <entry>
            <string>S</string>
            <pin>
              <pos x="80" y="0"/>
              <showLabel>true</showLabel>
            </pin>
          </entry>
          <entry>
            <string>C</string>
            <pin>
              <pos x="80" y="40"/>
              <showLabel>true</showLabel>
            </pin>
          </entry>
        </pins>
        <drawables>
          <poly>
            <poly path="M 0,0 L 80,0 L 80,80 L 0,80 Z" evenOdd="false"/>
            <thickness>3</thickness>
            <filled>false</filled>
            <color>
              <red>0</red>
              <green>0</green>
              <blue>0</blue>
              <alpha>255</alpha>
            </color>
          </poly>
          <text>
            <p1 x="40" y="46"/>
            <p2 x="41" y="46"/>
            <text>HA</text>
            <orientation>CENTERBOTTOM</orientation>
            <size>16</size>
            <color>
              <red>0</red>
              <green>0</green>
              <blue>0</blue>
              <alpha>255</alpha>
            </color>
          </text>
          <text>
            <p1 x="8" y="16"/>
            <p2 x="9" y="16"/>
            <text>A</text>
            <orientation>LEFTBOTTOM</orientation>
            <size>14</size>
            <color>
              <red>80</red>
              <green>80</green>
              <blue>80</blue>
              <alpha>255</alpha>
            </color>
          </text>
          <text>
            <p1 x="8" y="56"/>
            <p2 x="9" y="56"/>
            <text>B</text>
            <orientation>LEFTBOTTOM</orientation>
            <size>14</size>
            <color>
              <red>80</red>
              <green>80</green>
              <blue>80</blue>
              <alpha>255</alpha>
            </color>
          </text>
          <text>
            <p1 x="72" y="16"/>
            <p2 x="73" y="16"/>
            <text>S</text>
            <orientation>RIGHTBOTTOM</orientation>
            <size>14</size>
            <color>
              <red>80</red>
              <green>80</green>
              <blue>80</blue>
              <alpha>255</alpha>
            </color>
          </text>
          <text>
            <p1 x="72" y="56"/>
            <p2 x="73" y="56"/>
            <text>C</text>
            <orientation>RIGHTBOTTOM</orientation>
            <size>14</size>
            <color>
              <red>80</red>
              <green>80</green>
              <blue>80</blue>
              <alpha>255</alpha>
            </color>
          </text>
        </drawables>
      </shape>
    </entry>
  </attributes>
  <visualElements>
    <visualElement>
      <elementName>XOr</elementName>
      <elementAttributes/>
      <pos x="600" y="240"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
