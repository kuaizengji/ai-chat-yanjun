        <entry>
          <string>RectHeight</string>
          <int>12</int>
        </entry>
        <entry>
          <string>RectWidth</string>
          <int>12</int>
        </entry>
        <entry>
          <string>Label</string>
          <string>Half Adder  S=A⊕B  C=A∧B</string>
        </entry>
      </elementAttributes>
      <pos x="520" y="200"/>
    </visualElement>
