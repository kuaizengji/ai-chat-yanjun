      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>Y_0</string>
        </entry>
        <entry>
          <string>Description</string>
          <string>LSB of -X in 4-bit two's complement</string>
        </entry>
      </elementAttributes>
      <pos x="620" y="160"/>
    </visualElement>
    <visualElement>
