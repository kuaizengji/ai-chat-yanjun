    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Label</string>
          <string>all-8-inputs</string>
        </entry>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString># All 8 inputs. Y is the 4-bit two's complement of -X.
# 001 -&gt; 1111 (-1); 010 -&gt; 1110 (-2); 000 -&gt; 0000; 111 -&gt; 1001 (-7).
X_2 X_1 X_0 Y_3 Y_2 Y_1 Y_0
loop(n,8)
bits(3,n) bits(4,16-n)
end loop
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="140" y="400"/>
    </visualElement>
